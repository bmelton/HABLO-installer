{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hablo.dev/schemas/dream-proposals-v1.json",
  "title": "HABLO Dream proposals",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "proposals"],
  "properties": {
    "version": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "problem", "target", "change", "evidence", "confidence", "alreadyCovered"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "problem": { "type": "string" },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo", "file", "kind"],
            "properties": {
              "repo": { "type": "string", "minLength": 1 },
              "file": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 }
            }
          },
          "change": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["append-section", "replace-section", "json-merge", "add-task", "manual"] },
              "heading": { "type": "string" },
              "body": { "type": "string" },
              "values": { "type": "object" }
            }
          },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "confidence": { "enum": ["low", "medium", "high"] },
          "alreadyCovered": { "type": ["string", "null"] },
          "fingerprint": { "type": "string" }
        }
      }
    }
  }
}
